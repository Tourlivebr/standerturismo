---
import type { Ticket } from '../data/ingressos';
interface Props { items: Ticket[]; preview?: boolean; }
const { items, preview = false } = Astro.props;
const listId = preview ? "ticket-preview-list" : "ticket-catalog-list";
---
<div id={listId} class:list={['ticket-list', { 'ticket-preview': preview }]}>
 {items.map(ticket => <a class="ticket-row" href={ticket.linkOficial} target="_blank" rel="noopener noreferrer">
  <img class="ticket-thumbnail" src={ticket.imagem} alt="" width="140" height="125" loading="lazy" decoding="async" />
  <div class="ticket-information">
   <h3>{ticket.titulo}</h3>
   <p class="ticket-description">{ticket.subtitulo}</p>
   <p class="ticket-value">Consultar valores</p>
  </div>
  <span class="ticket-open"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"/></svg><span class="sr-only">Ver ingresso</span></span>
 </a>)}
</div>
{preview && items.length > 4 && <div class="ticket-more"><button type="button" aria-expanded="false" aria-controls={listId}>Ver mais <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></button></div>}
<style>
 .ticket-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;font-family:Arial,Helvetica,sans-serif}
 .ticket-row{display:flex;align-items:center;gap:18px;min-width:0;padding:22px 18px;background:#fff;border:1px solid #edf0ed;border-radius:24px;box-shadow:0 8px 25px #153b2510;text-decoration:none;color:#28352d;transition:box-shadow .2s,transform .2s}
 .ticket-row:hover{box-shadow:0 12px 30px #153b2520;transform:translateY(-2px)}
 .ticket-row:focus-visible,.ticket-more button:focus-visible{outline:3px solid #c89a3c;outline-offset:4px}
 .ticket-thumbnail{width:122px;height:125px;flex-shrink:0;border-radius:18px;object-fit:cover;background:#edf1ed}
 .ticket-information{flex:1;min-width:0}
 .ticket-information h3{margin:0 0 10px;font-family:Arial,Helvetica,sans-serif;font-size:19px;line-height:1.2;font-weight:750;color:#29352e}
 .ticket-description{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;line-clamp:2;overflow:hidden;margin:0;color:#697970;font-size:13px;line-height:1.45}
 .ticket-information .ticket-value{margin:12px 0 0;color:#123e2a;font-size:14px;font-weight:700}
 .ticket-open{display:grid;place-items:center;flex-shrink:0;width:44px;height:44px;border-radius:15px;background:#eef3ef;color:#123e2a}
 .ticket-open svg,.ticket-more svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
 .ticket-more{display:none;text-align:center;margin-top:24px}
 .ticket-more button{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:46px;padding:12px 30px;border-radius:999px;background:#123e2a;color:white;text-decoration:none;font:600 14px Arial,Helvetica,sans-serif;border:0;cursor:pointer}
 .ticket-more button:hover{background:#1c573d}
 @media(max-width:900px){.ticket-list{grid-template-columns:1fr}}
 @media(max-width:540px){.ticket-list{gap:12px}.ticket-row{gap:10px;padding:14px 12px;border-radius:20px;min-height:136px}.ticket-thumbnail{width:88px;height:106px;border-radius:14px}.ticket-information h3{font-size:15px;margin-bottom:8px;line-height:1.25}.ticket-description{font-size:12px}.ticket-information .ticket-value{font-size:12px;margin-top:9px}.ticket-open{width:30px;height:36px;border-radius:11px}.ticket-open svg{width:18px;height:18px}.ticket-preview:not(.is-expanded) .ticket-row:nth-child(n+5){display:none}.ticket-more{display:block}}
 @media(prefers-reduced-motion:reduce){.ticket-row{transition:none}}
</style>

<script>
 document.querySelectorAll<HTMLButtonElement>(".ticket-more button").forEach(button => {
  button.addEventListener("click", () => {
   const list = document.getElementById(button.getAttribute("aria-controls") || "");
   if (!list) return;
   list.classList.add("is-expanded");
   button.setAttribute("aria-expanded", "true");
   list.querySelectorAll<HTMLAnchorElement>(".ticket-row")[4]?.focus({ preventScroll: true });
   button.parentElement?.remove();
  });
 });
</script>
