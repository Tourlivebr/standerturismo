---
import BaseLayout from '../layouts/BaseLayout.astro';
import NatalHeroVideo from './NatalHeroVideo.astro';
import TravelGuide from '../components/TravelGuide.astro';
import TravelFAQ from '../components/TravelFAQ.astro';
import AboutUs from '../components/AboutUs.astro';
import '../styles/home.css';
import { tourSummaries, tourWhatsAppUrl } from '../data/tour-contact';
import TicketList from '../components/TicketList.astro';
import { ingressos } from '../data/ingressos';
import { readdirSync } from 'node:fs';
const { catalog: toursCatalog = false, ticketsCatalog = false } = Astro.props;
const catalog = toursCatalog || ticketsCatalog;
const heroImages = ticketsCatalog ? ['/images/link_ingressos.jpg'] : catalog ? ['/images/hero/hero%20(3).jpeg'] : readdirSync(new URL('../../public/images/hero/', import.meta.url))
 .filter(name => /\.(jpe?g|png|webp|avif)$/i.test(name))
 .sort((a, b) => a.localeCompare(b, 'pt-BR', { numeric: true }))
 .map(name => `/images/hero/${encodeURIComponent(name)}`);
const wa = 'https://wa.me/5547984887630';
// Substitua pelo link definitivo do PDF quando estiver disponível.
const guidePdfUrl = '/downloads/guia-gramado-canela.pdf';
const showDestinations = false;
const destinations = [
 {name:'Gramado',image:'/images/Nova_Petropolis.jpg'},
 {name:'Canela',image:'/images/jolimont/catedral.jpeg'},
 {name:'Serra Gaúcha',image:'/images/olivas/olivas_card.jpg'},
 {name:'Outros destinos',image:'/images/jolimont/jolimont.jpg'}
];
const tours = [
 {name:'Transfer Aeroporto/Hotel',image:'/images/Transfer/Transfer.jpeg',tag:'Destaque · Ida e volta',location:'Porto Alegre e Região',detail:'',href:'/passeio/transfer-ida-volta-porto-alegre'},
 {name:'City Tour Privativo',image:'/images/jolimont/catedral.jpeg',tag:'Do seu jeito',location:'Gramado e Canela',detail:'',price:380,href:'/passeio/city-tour-privativo'},
 {name:'Skyglass Canela',image:'/images/skyglass/skyglass.jpg',tag:'Aventura',location:'Canela',detail:'Translado',price:200,href:'/passeio/transporte-sky-glass'},
 {name:'Vinícola Jolimont',image:'/images/jolimont/jolimont.jpg',tag:'Vinhos e paisagens',location:'Canela',detail:'Translado',href:'/passeio/transporte-jolimont'},
 {name:'Olivas de Gramado',image:'/images/olivas/olivas_card.jpg',tag:'Natureza',location:'Gramado',detail:'Translado',price:200,href:'/passeio/transporte-olivas'},
 {name:'Bondinhos Aéreos',image:'/images/bondinhos.avif',tag:'Aventura',location:'Canela',detail:'Translado',href:'/passeio/bondinhos-transporte'},
 {name:'Passeio de Maria Fumaça',image:'/images/maria-fumaca/fumaca01.jpg',tag:'Uma viagem no tempo',location:'Serra Gaúcha',detail:'',price:1300,href:'/passeio/maria-fumaca'},
 {name:'Snowland',image:'/images/snowland/snowland.webp',tag:'Diversão na neve',location:'Gramado',detail:'',href:'/parksnet'},
 {name:'Lumini',image:'/images/lumini.webp',tag:'Uma experiência especial',location:'Gramado',detail:'Translado',href:'/passeio/lumni-transporte'}
];

if (toursCatalog) tours.push(
 {name:'City Tour Nova Petrópolis',image:'/images/Nova_Petropolis.jpg',tag:'Cultura e tradição',location:'Nova Petrópolis',detail:'',href:'/passeio/city-tour-nova-petropolis'},
 {name:'Tour Vinhos e Sabores',image:'/images/jolimont/Jolimont1.png',tag:'Vinhos e sabores',location:'Gramado e Canela',detail:'',href:'/passeio/tour-vinhos-e-sabores'}
);
const catalogCards = ticketsCatalog ? ingressos.map(ticket => ({
 name: ticket.titulo, image: ticket.imagem, tag: ticket.categoria,
 location: ticket.slug === 'parksnet' ? 'Gramado e Canela' : 'Gramado',
 detail: '', href: '/' + ticket.slug, summary: ticket.subtitulo,
})) : tours.map(tour => ({...tour, summary: tourSummaries[tour.href.split('/').pop()!]}));
---
<BaseLayout title={ticketsCatalog ? "Ingressos e Atrações | Stander Turismo" : catalog ? "Passeios | Stander Turismo" : "Stander Turismo | Experiências inesquecíveis na Serra Gaúcha"} description="Viva o melhor de Gramado, Canela e da Serra Gaúcha. Passeios, ingressos e roteiros personalizados com a Stander Turismo." image="/images/logo_sander_p.jpeg">
 <div class="stander-home">
  <svg class="icon-library" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><defs>
   <symbol id="i-search" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="7.5"/><path d="m16 16 5 5"/></symbol>
   <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M4 12h16m-6-6 6 6-6 6"/></symbol>
   <symbol id="i-pin" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0"/><circle cx="12" cy="10" r="3"/></symbol>
   <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M8 2v4m8-4v4M3 10h18"/></symbol>
   <symbol id="i-people" viewBox="0 0 24 24"><circle cx="9" cy="7" r="4"/><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m20 0v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></symbol>
   <symbol id="i-whatsapp" viewBox="0 0 24 24"><path d="M21 11.5a9 9 0 0 1-13.6 7.7L3 21l1.8-4.5A9 9 0 1 1 21 11.5M8 7c0 5 4 9 9 9l1-3-3-1-1 1c-2-1-3-2-4-4l1-1-1-3z"/></symbol>
   <symbol id="i-route" viewBox="0 0 24 24"><path d="M9 4H5a2 2 0 0 0-2 2v14h16V10M12 3l3 3-3 3m3-3h-3v8h4"/></symbol><symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 2"/></symbol><symbol id="i-shield" viewBox="0 0 24 24"><path d="m12 3-9 4v5c0 5 9 10 9 10s9-5 9-10V7zM9 12l2 2 4-4"/></symbol><symbol id="i-menu" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/></symbol>
  </defs></svg>
  <header class="home-header"><div class="home-container header-inner">
   <button class="mobile-menu-toggle icon-button" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="home-navigation"><svg class="icon" aria-hidden="true"><use href="#i-menu"/></svg></button>
   <a class="home-logo" href="/" aria-label="Stander Turismo — início"><img src="/images/logo_sander_p.jpeg" alt="Stander Turismo" width="110" height="110" fetchpriority="high"/></a>
   <nav id="home-navigation" aria-label="Navegação principal"><a href={catalog ? "/" : "#inicio"} class:list={{active: !catalog}} aria-current={!catalog ? "page" : undefined}>Início</a><a href="/passeios" class:list={{active: toursCatalog}} aria-current={toursCatalog ? "page" : undefined}>Passeios</a><a href={catalog ? "/ingressos" : "#ingressos"} class:list={{active: ticketsCatalog}} aria-current={ticketsCatalog ? "page" : undefined}>Ingressos</a>{showDestinations && <a href={catalog ? "/#destinos" : "#destinos"}>Destinos</a>}<a href={catalog ? "/#sobre" : "#sobre"}>Sobre</a><a href="#contato">Contato</a></nav>
   <div class="header-actions"><a class="header-search icon-button" href="/passeios" aria-label="Ver passeios"><svg class="icon" aria-hidden="true"><use href="#i-search"/></svg></a><a class="green-button header-whatsapp" href={wa} target="_blank" rel="noopener noreferrer" aria-label="Fale no WhatsApp"><svg class="icon" aria-hidden="true"><use href="#i-whatsapp"/></svg><span>Fale no WhatsApp</span></a></div>
  </div></header>
  <main>
   <section id="inicio" class="home-hero" aria-labelledby="hero-title"><div class="hero-background" aria-hidden="true">{heroImages.map((src, index) => <img class:list={['hero-landscape', { 'is-active': index === 0 }]} src={src} alt="" fetchpriority={index === 0 ? 'high' : 'low'} decoding="async" />)}</div>{!catalog && <NatalHeroVideo />}
    <button class="hero-carousel-toggle" type="button" aria-label="Pausar carrossel de imagens" aria-pressed="false" hidden={!catalog || heroImages.length < 2}><svg class="icon pause-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5v14M15 5v14"/></svg><svg class="icon play-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7z"/></svg></button>
    <div class="home-container hero-content">{catalog && <p class="eyebrow">{ticketsCatalog ? "Diversão e experiências na Serra Gaúcha" : "Explore a Serra Gaúcha"}</p>}<h1 id="hero-title" class:list={{"hero-natal-title": !catalog}}>{ticketsCatalog ? <>Ingressos para<br/>momentos especiais</> : catalog ? <>Passeios para<br/>viver e recordar</> : <><span class="hero-natal-heading"><span class="hero-festive-stars" aria-hidden="true">✧ <span>✦</span> ✧</span><span class="hero-natal-lead">Viva a magia do</span><span class="hero-natal-name">Natal Luz<span class="hero-natal-spark" aria-hidden="true">✧</span></span></span><span class="hero-natal-brand">com a <strong>Stander Turismo</strong></span></>}</h1>{catalog && <p class="hero-description">{ticketsCatalog ? <>Descubra parques, shows e atrações em Gramado e Canela.<br class="desktop-break"/> Garanta sua experiência com a Stander Turismo.</> : <>Conheça Gramado, Canela e a Serra Gaúcha<br class="desktop-break"/> com passeios e roteiros da Stander Turismo.</>}</p>}
    {!catalog && <a class="gold-button hero-natal-cta" href={tourWhatsAppUrl("Natal Luz de Gramado")} target="_blank" rel="noopener noreferrer">Planeje o seu Natal Luz<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>}
    </div>
   </section>

   <div class="hero-links-wrap home-container"><nav class="hero-links" aria-label="Explore a Stander Turismo">
    <a href="/passeios"><svg class="icon" aria-hidden="true"><use href="#i-route"/></svg><span>Passeios</span></a>
    <a href="/ingressos"><svg class="icon" aria-hidden="true"><use href="#i-calendar"/></svg><span>Ingressos</span></a>
    <a href="#contato"><svg class="icon" aria-hidden="true"><use href="#i-whatsapp"/></svg><span>Contato</span></a>
   </nav></div>
   {showDestinations && <section id="destinos" class="home-section destinations-section" aria-labelledby="destinations-title"><div class="home-container">
    <div class="section-heading"><div><h2 id="destinations-title">Os mais procurados pelos nossos clientes.</h2></div><a class="view-all" href="/passeios">Ver todos os destinos <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a></div>
    <div class="destination-grid">{destinations.map(d => <a class="destination-card" href="/passeios"><img src={d.image} alt={d.name === 'Gramado' ? 'Arquitetura e jardins da Serra Gaúcha' : d.name} loading="lazy" width="400" height="440"/><div class="destination-caption"><h3>{d.name}</h3><span>Passeios e ingressos</span></div><span class="destination-arrow"><svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></span></a>)}</div>
   </div></section>}
   <section id={ticketsCatalog ? "ingressos" : "passeios"} class="home-section" aria-labelledby="tours-title"><div class="home-container">
    <div class="section-heading"><div><h2 id="tours-title">{ticketsCatalog ? "Todos os ingressos e atrações" : catalog ? "Todos os passeios" : "Torne sua viagem inesquecível."}</h2></div></div>
    <div id="home-tour-list" class:list={["product-grid", "tours-preview", {"tours-catalog": catalog}]}>{catalogCards.map((t, index) => <article class:list={['product-card', { 'tour-featured': !ticketsCatalog && index === 0 }]} hidden={index >= 4}><a class="product-image" href={tourWhatsAppUrl(t.name)} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true"><img src={t.image} alt="" loading="lazy" width="400" height="300"/><div class="product-tags"><span class="product-tag">{t.tag}</span>{t.detail === 'Translado' && <span class="product-tag product-transfer-tag">Translado</span>}</div></a><div class="product-content"><h3><a href={tourWhatsAppUrl(t.name)} target="_blank" rel="noopener noreferrer">{t.name}</a></h3><p class="product-meta"><svg class="icon" aria-hidden="true"><use href="#i-pin"/></svg>{t.location}</p>{t.detail && t.detail !== 'Translado' && <p class="product-meta"><svg class="icon" aria-hidden="true"><use href="#i-route"/></svg>{t.detail}</p>}<p class="tour-summary">{t.summary}</p><a class="green-button product-button" href={tourWhatsAppUrl(t.name)} target="_blank" rel="noopener noreferrer"><svg class="icon" aria-hidden="true"><use href="#i-whatsapp"/></svg><span>Fale com a Stander Turismo</span></a></div></article>)}</div>
    <div class:list={["tours-more", {"catalog-controls": catalog}]}>{!catalog && <a class="green-button tours-catalog-link" href="/passeios">Ver mais <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>}<div class="tours-expand-controls" hidden><button class="green-button tours-expand" type="button" aria-expanded="false" aria-controls="home-tour-list">Ver mais <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></button><button class="green-button tours-collapse" type="button" aria-controls="home-tour-list" hidden>Ver menos <span aria-hidden="true">↑</span></button><span class="sr-only tours-count" role="status" aria-live="polite"></span></div></div>
   </div></section>
   {!catalog && <>
   <section id="experiencias" class="experience-section" aria-labelledby="experience-title"><div class="experience-banner"><img src="/images/olivas/olivas_card.jpg" alt="Vales e natureza em Olivas de Gramado" loading="lazy" width="2500" height="1160"/><div class="experience-copy"><p class="eyebrow">Viva novas histórias</p><h2 id="experience-title">Experiências que<br/>ficam para sempre</h2><p>Passeios, ingressos e roteiros completos com atendimento especializado.</p><a class="gold-button" href="/passeios">Explorar passeios <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a></div><div class="experience-details"><p><svg class="icon" aria-hidden="true"><use href="#i-route"/></svg><span>Roteiros personalizados</span></p><p><svg class="icon" aria-hidden="true"><use href="#i-clock"/></svg><span>Planeje no seu ritmo</span></p><p><svg class="icon" aria-hidden="true"><use href="#i-whatsapp"/></svg>Suporte no WhatsApp</p><p><svg class="icon" aria-hidden="true"><use href="#i-shield"/></svg><span>Sua viagem bem cuidada</span></p></div></div></section>
   <section id="ingressos" class="home-section tickets-section" aria-labelledby="tickets-title"><div class="home-container">
    <div class="section-heading"><div><h2 id="tickets-title">Ingressos e Atrações</h2><p>Garanta seus ingressos para as principais atrações da região.</p></div><a class="view-all" href="/ingressos">Ver todos os ingressos <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a></div>
    <TicketList items={ingressos} preview />
   </div></section>
   <AboutUs />
   <TravelGuide pdfUrl={guidePdfUrl} />
   <TravelFAQ />
   </>}
  </main>
  <footer id="contato" class="home-footer"><div class="home-container footer-main"><div><a class="footer-brand" href="/">Stander <span>Turismo</span></a><p>Seu próximo destino. Uma nova história.</p></div><div><h2>Vamos planejar sua viagem?</h2><a href={wa} target="_blank" rel="noopener noreferrer">WhatsApp: (47) 98488-7630</a><a href="mailto:felipetorrestander@gmail.com">felipetorrestander@gmail.com</a></div><div class="footer-links"><a href="/passeios">Passeios</a><a href="/ingressos">Ingressos</a><a href="/translados">Translados</a><a href="https://www.instagram.com/Standerturismo/" target="_blank" rel="noopener noreferrer">Instagram ↗</a></div></div><div class="home-container footer-bottom">© {new Date().getFullYear()} Stander Turismo. Todos os direitos reservados.</div></footer>
 </div>
</BaseLayout>
<script>
 const tourList = document.querySelector<HTMLElement>('#home-tour-list');
 const tourControls = document.querySelector<HTMLElement>('.tours-expand-controls');
 const moreTours = document.querySelector<HTMLButtonElement>('.tours-expand');
 const fewerTours = document.querySelector<HTMLButtonElement>('.tours-collapse');
 if (tourList && tourControls && moreTours && fewerTours) {
  const cards = Array.from(tourList.querySelectorAll<HTMLElement>('.product-card'));
  const mobileTours = window.matchMedia("(max-width: 540px)");
  const isCatalog = tourList.classList.contains("tours-catalog");
  let visibleCount = isCatalog && !mobileTours.matches ? cards.length : 4;
  tourControls.hidden = false;
  tourControls.parentElement?.classList.add('is-ready');
  const updateTours = () => {
   cards.forEach((card, index) => { card.hidden = index >= visibleCount; });
   moreTours.hidden = visibleCount >= cards.length;
   fewerTours.hidden = visibleCount <= 4;
   moreTours.setAttribute('aria-expanded', String(visibleCount > 4));
   const status = tourControls.querySelector('.tours-count');
   if (status) status.textContent = visibleCount + ' de ' + cards.length + ' passeios exibidos.';
  };
  updateTours();
  mobileTours.addEventListener("change", () => {
   visibleCount = isCatalog && !mobileTours.matches ? cards.length : 4;
   updateTours();
  });
  moreTours.addEventListener('click', () => {
   visibleCount = Math.min(cards.length, visibleCount + 4);
   updateTours();
   if (moreTours.hidden) fewerTours.focus({ preventScroll: true });
  });
  fewerTours.addEventListener('click', () => {
   visibleCount = Math.max(4, Math.floor((visibleCount - 1) / 4) * 4);
   updateTours();
   moreTours.focus({ preventScroll: true });
   moreTours.scrollIntoView({ block: 'nearest' });
  });
 }

 const hero = document.querySelector<HTMLElement>('.home-hero');
 const slides = Array.from(document.querySelectorAll<HTMLImageElement>('.hero-background .hero-landscape'));
 const pauseButton = document.querySelector<HTMLButtonElement>('.hero-carousel-toggle');
 let currentSlide = 0;
 let pausedByUser = false;
 let heroVisible = true;
 let timer: ReturnType<typeof setTimeout> | undefined;
 let stopped = false;
 const scheduleSlide = () => {
  clearTimeout(timer);
  if (document.querySelector('#natal-luz-player') || stopped || slides.length < 2 || pausedByUser || document.hidden || !heroVisible) return;
  timer = setTimeout(() => {
   let next = (currentSlide + 1) % slides.length;
   while (next !== currentSlide && (!slides[next].complete || slides[next].naturalWidth === 0)) next = (next + 1) % slides.length;
   if (next !== currentSlide) {
    slides[next].classList.add('is-active');
    slides[currentSlide].classList.remove('is-active');
    currentSlide = next;
   }
   scheduleSlide();
  }, 6000);
 };
 pauseButton?.addEventListener('click', () => {
  pausedByUser = !pausedByUser;
  pauseButton.setAttribute('aria-pressed', String(pausedByUser));
  pauseButton.setAttribute('aria-label', pausedByUser ? 'Retomar carrossel de imagens' : 'Pausar carrossel de imagens');
  scheduleSlide();
 });
 document.addEventListener('visibilitychange', scheduleSlide);
 if (hero && 'IntersectionObserver' in window) {
  const observer = new IntersectionObserver(([entry]) => { heroVisible = entry.isIntersecting; scheduleSlide(); });
  observer.observe(hero);
  window.addEventListener('pagehide', () => observer.disconnect());
  window.addEventListener('pageshow', () => observer.observe(hero));
 }
 window.addEventListener('pagehide', () => { stopped = true; clearTimeout(timer); });
 window.addEventListener('pageshow', () => { stopped = false; scheduleSlide(); });
 scheduleSlide();

 const toggle = document.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
 const nav = document.querySelector<HTMLElement>('#home-navigation');
 const close = () => { toggle?.setAttribute('aria-expanded','false'); toggle?.setAttribute('aria-label','Abrir menu'); nav?.classList.remove('is-open'); };
 toggle?.addEventListener('click',() => { const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded',String(open)); toggle.setAttribute('aria-label',open ? 'Fechar menu' : 'Abrir menu'); nav?.classList.toggle('is-open',open); });
 nav?.querySelectorAll('a').forEach(a => a.addEventListener('click',close));
 document.addEventListener('keydown',e => { if(e.key === 'Escape') close(); });
 document.addEventListener('click',e => { if(e.target instanceof Node && !nav?.contains(e.target) && !toggle?.contains(e.target)) close(); });
</script>
