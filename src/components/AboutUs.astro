---
import { readdirSync } from 'node:fs';
const photos = readdirSync(new URL('../../public/images/quemsomos/', import.meta.url))
 .filter(name => /\.(jpe?g|png|webp|avif)$/i.test(name))
 .sort((a, b) => a.localeCompare(b, 'pt-BR', { numeric: true }))
 .map(name => `/images/quemsomos/${encodeURIComponent(name)}`);
---
<section id="sobre" class="about-us" aria-labelledby="about-title">
 <div class="about-intro">
  <div class="about-copy"><p class="about-eyebrow">Quem somos</p><h2 id="about-title">Mais que destinos,<br/>conectamos pessoas<br/>a novas histórias.</h2><p>Somos a Stander Turismo. Ajudamos você a viver o melhor de Gramado, Canela e da Serra Gaúcha, com passeios, ingressos e translados que combinam com o seu jeito de viajar.</p><p>Do planejamento aos momentos que ficam na memória, oferecemos atendimento próximo e roteiros personalizados para você aproveitar cada experiência com tranquilidade.</p><a class="about-contact" href="https://wa.me/5547984887630" target="_blank" rel="noopener noreferrer">Vamos planejar sua viagem <span aria-hidden="true">↗</span></a></div>
  <img class="about-brand-logo" src="/images/logo_sander_p.jpeg" alt="Stander Turismo" width="320" height="320" loading="lazy" decoding="async" />
 </div>
 <div class="about-film-heading"><p>Gente, lugares e momentos que fazem parte da nossa história.</p><button class="about-film-toggle" type="button" aria-pressed="false" aria-label="Pausar faixa de fotos"><span class="film-pause" aria-hidden="true">Ⅱ</span><span class="film-play" aria-hidden="true">▷</span></button></div>
 <div class="about-film" aria-label="Fotos de viagens com a Stander Turismo">
  <div class="about-film-track" style={`--film-duration:${photos.length * 2.8}s`}>
   <div class="about-film-group">{photos.map((src, index) => <img src={src} alt={`Momentos com a Stander Turismo — foto ${index + 1}`} width="280" height="240" loading="lazy" decoding="async" />)}</div>
   <div class="about-film-group" aria-hidden="true">{photos.map(src => <img src={src} alt="" width="280" height="240" loading="lazy" decoding="async" />)}</div>
  </div>
 </div>
</section>
<script>
 const film = document.querySelector<HTMLElement>('.about-film-track');
 const toggle = document.querySelector<HTMLButtonElement>('.about-film-toggle');
 toggle?.addEventListener('click', () => {
  const paused = toggle.getAttribute('aria-pressed') !== 'true';
  toggle.setAttribute('aria-pressed', String(paused));
  toggle.setAttribute('aria-label', paused ? 'Retomar faixa de fotos' : 'Pausar faixa de fotos');
  film?.classList.toggle('is-paused', paused);
 });
</script>
<style>
 .about-us{padding:65px 0 0;background:#f8f7f3;overflow:hidden;scroll-margin-top:112px}
 .about-intro{width:min(1180px,calc(100% - 96px));margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) minmax(220px,320px);align-items:center;gap:60px}
.about-brand-logo{display:block;width:100%;max-width:320px;height:auto;justify-self:center;object-fit:contain;mix-blend-mode:darken;border:0;border-radius:0;background:transparent}
 .about-copy{max-width:850px}.about-copy .about-eyebrow{text-transform:uppercase;font:600 12px Arial,sans-serif;letter-spacing:1.8px;color:#a87c25;margin:0 0 15px}
 .about-copy h2{font:500 43px/1.1 Georgia,serif!important;color:#123e2a;letter-spacing:-1px;margin:0 0 23px!important}
 .about-copy>p:not(.about-eyebrow){font:15px/1.75 Arial,sans-serif;color:#657066;margin:0 0 15px}
 .about-contact{display:inline-flex;align-items:center;gap:15px;margin-top:8px;padding:12px 22px;border-radius:999px;background:#123e2a;color:#fff!important;font:500 14px Arial,sans-serif;text-decoration:none;min-height:45px}.about-contact:hover{background:#1c573d}
 .about-film-heading{width:min(1180px,calc(100% - 96px));margin:45px auto 18px;display:flex;align-items:center;justify-content:space-between;gap:15px}
 .about-film-heading p{font:13px/1.5 Arial,sans-serif;color:#667367;margin:0}
 .about-film-toggle{display:grid;place-items:center;flex-shrink:0;width:36px;height:36px;border:1px solid #cfd8ca;border-radius:50%;background:#fff;color:#123e2a;cursor:pointer;font:19px Arial,sans-serif}
 .film-play{display:none}.about-film-toggle[aria-pressed="true"] .film-pause{display:none}.about-film-toggle[aria-pressed="true"] .film-play{display:block}
 .about-contact:focus-visible,.about-film-toggle:focus-visible{outline:3px solid #c89a3c;outline-offset:4px}
 .about-film{width:100%;overflow:hidden;background:#123e2a}
 .about-film-track{display:flex;width:max-content;animation:about-film-loop var(--film-duration) linear infinite;will-change:transform}
 .about-film-track.is-paused{animation-play-state:paused}
 .about-film-group{display:flex;flex-shrink:0;gap:0}
 .about-film-group img{display:block;flex-shrink:0;width:280px;height:240px;object-fit:cover;object-position:center 38%;border:0;border-radius:0}
 @keyframes about-film-loop{from{transform:translateX(0)}to{transform:translateX(-50%)}}
 @media(max-width:800px){.about-intro{width:calc(100% - 40px);grid-template-columns:minmax(0,1fr) 220px;gap:30px}.about-copy h2{font-size:34px!important}.about-film-heading{width:calc(100% - 40px)}}
 @media(max-width:540px){.about-us{padding-top:35px;scroll-margin-top:90px}.about-intro{width:calc(100% - 32px);grid-template-columns:1fr;gap:26px}.about-brand-logo{max-width:180px;order:-1}.about-copy h2{font-size:34px!important;margin-bottom:18px!important}.about-copy>p:not(.about-eyebrow){font-size:14px}.about-contact{font-size:13px}.about-film-heading{width:calc(100% - 32px);margin-top:30px;margin-bottom:14px}.about-film-heading p{font-size:12px}.about-film-group img{width:210px;height:190px}}
 @media(prefers-reduced-motion:reduce){.about-film-track{animation-duration:calc(var(--film-duration) * 2)}}
</style>
