---
import BaseLayout from '../layouts/BaseLayout.astro';
import TravelGuide from '../components/TravelGuide.astro';
import AboutUs from '../components/AboutUs.astro';
import '../styles/home.css';
import TicketList from '../components/TicketList.astro';
import { ingressos } from '../data/ingressos';
import { readdirSync } from 'node:fs';
const heroImages = readdirSync(new URL('../../public/images/hero/', import.meta.url))
 .filter(name => /\.(jpe?g|png|webp|avif)$/i.test(name))
 .sort((a, b) => a.localeCompare(b, 'pt-BR', { numeric: true }))
 .map(name => `/images/hero/${encodeURIComponent(name)}`);
const wa = 'https://wa.me/5547984887630';
// Substitua pelo link definitivo do PDF quando estiver disponível.
const guidePdfUrl = '/downloads/guia-gramado-canela.pdf';
const showDestinations = false;
const destinations = [
 {name:'Gramado',image:'/images/Nova_Petropolis.jpg'},
 {name:'Canela',image:'/images/jolimont/catedral.png'},
 {name:'Serra Gaúcha',image:'/images/olivas/olivas_card.jpg'},
 {name:'Outros destinos',image:'/images/jolimont/jolimont.jpg'}
];
const tours = [
 {name:'Passeio de Maria Fumaça',image:'/images/maria-fumaca/fumaca01.jpg',tag:'Uma viagem no tempo',location:'Serra Gaúcha',detail:'1 a 2 pessoas',price:1300,href:'/passeio/maria-fumaca'},
 {name:'City Tour Privativo',image:'/images/jolimont/catedral.png',tag:'Do seu jeito',location:'Gramado e Canela',detail:'1 a 4 pessoas',price:380,href:'/passeio/city-tour-privativo'},
 {name:'Olivas de Gramado',image:'/images/olivas/olivas_card.jpg',tag:'Natureza',location:'Gramado',detail:'Translado · 1 a 4 pessoas',price:200,href:'/passeio/transporte-olivas'},
 {name:'Skyglass Canela',image:'/images/skyglass/skyglass.jpg',tag:'Aventura',location:'Canela',detail:'Translado · 1 a 4 pessoas',price:200,href:'/passeio/transporte-sky-glass'}
];

const money = (price: number) => new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'}).format(price);
---
<BaseLayout title="Stander Turismo | Experiências inesquecíveis na Serra Gaúcha" description="Viva o melhor de Gramado, Canela e da Serra Gaúcha. Passeios, ingressos e roteiros personalizados com a Stander Turismo." image="/images/logo_sander_p.jpeg">
 <div class="stander-home">
  <svg class="icon-library" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><defs>
   <symbol id="i-search" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="7.5"/><path d="m16 16 5 5"/></symbol>
   <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M4 12h16m-6-6 6 6-6 6"/></symbol>
   <symbol id="i-pin" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0"/><circle cx="12" cy="10" r="3"/></symbol>
   <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M8 2v4m8-4v4M3 10h18"/></symbol>
   <symbol id="i-people" viewBox="0 0 24 24"><circle cx="9" cy="7" r="4"/><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m20 0v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></symbol>
   <symbol id="i-whatsapp" viewBox="0 0 24 24"><path d="M21 11.5a9 9 0 0 1-13.6 7.7L3 21l1.8-4.5A9 9 0 1 1 21 11.5M8 7c0 5 4 9 9 9l1-3-3-1-1 1c-2-1-3-2-4-4l1-1-1-3z"/></symbol>
   <symbol id="i-route" viewBox="0 0 24 24"><path d="M9 4H5a2 2 0 0 0-2 2v14h16V10M12 3l3 3-3 3m3-3h-3v8h4"/></symbol><symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 2"/></symbol><symbol id="i-shield" viewBox="0 0 24 24"><path d="m12 3-9 4v5c0 5 9 10 9 10s9-5 9-10V7zM9 12l2 2 4-4"/></symbol><symbol id="i-menu" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/></symbol>
  </defs></svg>
  <header class="home-header"><div class="home-container header-inner">
   <button class="mobile-menu-toggle icon-button" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="home-navigation"><svg class="icon" aria-hidden="true"><use href="#i-menu"/></svg></button>
   <a class="home-logo" href="/" aria-label="Stander Turismo — início"><img src="/images/logo_sander_p.jpeg" alt="Stander Turismo" width="110" height="110" fetchpriority="high"/></a>
   <nav id="home-navigation" aria-label="Navegação principal"><a href="#inicio" class="active" aria-current="page">Início</a><a href="#passeios">Passeios</a><a href="#ingressos">Ingressos</a>{showDestinations && <a href="#destinos">Destinos</a>}<a href="#sobre">Sobre</a><a href="#contato">Contato</a></nav>
   <div class="header-actions"><a class="header-search icon-button" href="/passeios" aria-label="Ver passeios"><svg class="icon" aria-hidden="true"><use href="#i-search"/></svg></a><a class="green-button header-whatsapp" href={wa} target="_blank" rel="noopener noreferrer" aria-label="Fale no WhatsApp"><svg class="icon" aria-hidden="true"><use href="#i-whatsapp"/></svg><span>Fale no WhatsApp</span></a></div>
  </div></header>
  <main>
   <section id="inicio" class="home-hero" aria-labelledby="hero-title"><div class="hero-background" aria-hidden="true">{heroImages.map((src, index) => <img class:list={['hero-landscape', { 'is-active': index === 0 }]} src={src} alt="" fetchpriority={index === 0 ? 'high' : 'low'} decoding="async" />)}</div>
    <button class="hero-carousel-toggle" type="button" aria-label="Pausar carrossel de imagens" aria-pressed="false" hidden={heroImages.length < 2}><svg class="icon pause-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5v14M15 5v14"/></svg><svg class="icon play-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7z"/></svg></button>
    <div class="home-container hero-content"><p class="eyebrow">Descubra experiências incríveis</p><h1 id="hero-title">Viva o melhor<br/>do seu destino</h1><p class="hero-description">Passeios, ingressos e experiências inesquecíveis<br class="desktop-break"/> com a Stander Turismo.</p>
    </div>
   </section>

   <div class="hero-links-wrap home-container"><nav class="hero-links" aria-label="Explore a Stander Turismo">
    <a href="/passeios"><svg class="icon" aria-hidden="true"><use href="#i-route"/></svg><span>Passeios</span></a>
    <a href="/ingressos"><svg class="icon" aria-hidden="true"><use href="#i-calendar"/></svg><span>Ingressos</span></a>
    <a href="#contato"><svg class="icon" aria-hidden="true"><use href="#i-whatsapp"/></svg><span>Contato</span></a>
   </nav></div>
   {showDestinations && <section id="destinos" class="home-section destinations-section" aria-labelledby="destinations-title"><div class="home-container">
    <div class="section-heading"><div><h2 id="destinations-title">Os mais procurados pelos nossos clientes.</h2></div><a class="view-all" href="/passeios">Ver todos os destinos <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a></div>
    <div class="destination-grid">{destinations.map(d => <a class="destination-card" href="/passeios"><img src={d.image} alt={d.name === 'Gramado' ? 'Arquitetura e jardins da Serra Gaúcha' : d.name} loading="lazy" width="400" height="440"/><div class="destination-caption"><h3>{d.name}</h3><span>Passeios e ingressos</span></div><span class="destination-arrow"><svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></span></a>)}</div>
   </div></section>}
   <section id="passeios" class="home-section" aria-labelledby="tours-title"><div class="home-container">
    <div class="section-heading"><div><h2 id="tours-title">Passeios para tornar sua viagem inesquecível.</h2></div><a class="view-all" href="/passeios">Ver todos os passeios <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a></div>
    <div class="product-grid tours-preview">{tours.slice(0, 4).map(t => <article class="product-card"><a class="product-image" href={t.href} tabindex="-1" aria-hidden="true"><img src={t.image} alt="" loading="lazy" width="400" height="300"/><span class="product-tag">{t.tag}</span></a><div class="product-content"><h3><a href={t.href}>{t.name}</a></h3><p class="product-meta"><svg class="icon" aria-hidden="true"><use href="#i-pin"/></svg>{t.location}</p><p class="product-meta"><svg class="icon" aria-hidden="true"><use href="#i-people"/></svg>{t.detail}</p><div class="product-price"><span>A partir de</span><strong>{money(t.price)}</strong></div><a class="green-button product-button" href={t.href}>Ver detalhes</a></div></article>)}</div>
    <div class="tours-more"><a class="green-button" href="/passeios">Ver mais <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a></div>
   </div></section>
   <section id="experiencias" class="home-container experience-section" aria-labelledby="experience-title"><div class="experience-banner"><img src="/images/olivas/olivas_card.jpg" alt="Vales e natureza em Olivas de Gramado" loading="lazy" width="2500" height="1160"/><div class="experience-copy"><p class="eyebrow">Viva novas histórias</p><h2 id="experience-title">Experiências que<br/>ficam para sempre</h2><p>Passeios, ingressos e roteiros completos com atendimento especializado.</p><a class="gold-button" href="/passeios">Explorar passeios <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a></div><div class="experience-details"><p><svg class="icon" aria-hidden="true"><use href="#i-route"/></svg><span>Roteiros personalizados</span></p><p><svg class="icon" aria-hidden="true"><use href="#i-clock"/></svg><span>Planeje no seu ritmo</span></p><p><svg class="icon" aria-hidden="true"><use href="#i-whatsapp"/></svg>Suporte no WhatsApp</p><p><svg class="icon" aria-hidden="true"><use href="#i-shield"/></svg><span>Sua viagem bem cuidada</span></p></div></div></section>
   <section id="ingressos" class="home-section tickets-section" aria-labelledby="tickets-title"><div class="home-container">
    <div class="section-heading"><div><h2 id="tickets-title">Ingressos e Atrações</h2><p>Garanta seus ingressos para as principais atrações da região.</p></div><a class="view-all" href="/ingressos">Ver todos os ingressos <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a></div>
    <TicketList items={ingressos} preview />
   </div></section>
   <AboutUs />
   <TravelGuide pdfUrl={guidePdfUrl} />
  </main>
  <footer id="contato" class="home-footer"><div class="home-container footer-main"><div><a class="footer-brand" href="/">Stander <span>Turismo</span></a><p>Seu próximo destino. Uma nova história.</p></div><div><h2>Vamos planejar sua viagem?</h2><a href={wa} target="_blank" rel="noopener noreferrer">WhatsApp: (47) 98488-7630</a><a href="mailto:felipetorreStander@gmail.com">felipetorreStander@gmail.com</a></div><div class="footer-links"><a href="/passeios">Passeios</a><a href="/ingressos">Ingressos</a><a href="/translados">Translados</a><a href="https://www.instagram.com/Standerturismo/" target="_blank" rel="noopener noreferrer">Instagram ↗</a></div></div><div class="home-container footer-bottom">© {new Date().getFullYear()} Stander Turismo. Todos os direitos reservados.</div></footer>
 </div>
</BaseLayout>
<script>
 const hero = document.querySelector<HTMLElement>('.home-hero');
 const slides = Array.from(document.querySelectorAll<HTMLImageElement>('.hero-background .hero-landscape'));
 const pauseButton = document.querySelector<HTMLButtonElement>('.hero-carousel-toggle');
 let currentSlide = 0;
 let pausedByUser = false;
 let heroVisible = true;
 let timer: ReturnType<typeof setTimeout> | undefined;
 let stopped = false;
 const scheduleSlide = () => {
  clearTimeout(timer);
  if (stopped || slides.length < 2 || pausedByUser || document.hidden || !heroVisible) return;
  timer = setTimeout(() => {
   let next = (currentSlide + 1) % slides.length;
   while (next !== currentSlide && (!slides[next].complete || slides[next].naturalWidth === 0)) next = (next + 1) % slides.length;
   if (next !== currentSlide) {
    slides[next].classList.add('is-active');
    slides[currentSlide].classList.remove('is-active');
    currentSlide = next;
   }
   scheduleSlide();
  }, 6000);
 };
 pauseButton?.addEventListener('click', () => {
  pausedByUser = !pausedByUser;
  pauseButton.setAttribute('aria-pressed', String(pausedByUser));
  pauseButton.setAttribute('aria-label', pausedByUser ? 'Retomar carrossel de imagens' : 'Pausar carrossel de imagens');
  scheduleSlide();
 });
 document.addEventListener('visibilitychange', scheduleSlide);
 if (hero && 'IntersectionObserver' in window) {
  const observer = new IntersectionObserver(([entry]) => { heroVisible = entry.isIntersecting; scheduleSlide(); });
  observer.observe(hero);
  window.addEventListener('pagehide', () => observer.disconnect());
  window.addEventListener('pageshow', () => observer.observe(hero));
 }
 window.addEventListener('pagehide', () => { stopped = true; clearTimeout(timer); });
 window.addEventListener('pageshow', () => { stopped = false; scheduleSlide(); });
 scheduleSlide();

 const toggle = document.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
 const nav = document.querySelector<HTMLElement>('#home-navigation');
 const close = () => { toggle?.setAttribute('aria-expanded','false'); toggle?.setAttribute('aria-label','Abrir menu'); nav?.classList.remove('is-open'); };
 toggle?.addEventListener('click',() => { const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded',String(open)); toggle.setAttribute('aria-label',open ? 'Fechar menu' : 'Abrir menu'); nav?.classList.toggle('is-open',open); });
 nav?.querySelectorAll('a').forEach(a => a.addEventListener('click',close));
 document.addEventListener('keydown',e => { if(e.key === 'Escape') close(); });
 document.addEventListener('click',e => { if(e.target instanceof Node && !nav?.contains(e.target) && !toggle?.contains(e.target)) close(); });
</script>
